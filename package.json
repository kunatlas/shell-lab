{
  "name": "shell-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "在真实 Linux Bash 环境中练习 Shell",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "test": "node --import tsx --test --experimental-test-isolation=none tests/*.test.ts",
    "test:docker": "SHELL_LAB_TEST_DOCKER=1 node --import tsx --test --experimental-test-isolation=none tests/docker.test.ts",
    "test:browser": "playwright test",
    "test:desktop": "npm run build && playwright test --config=playwright.desktop.config.ts",
    "sandbox:build": "docker build -t shell-lab-sandbox:1 ./sandbox",
    "desktop": "npm run build && node scripts/desktop.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "express": "^5.1.0",
    "node-pty": "1.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "electron": "^44.9.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true
  }
}
