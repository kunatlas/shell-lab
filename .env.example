# Docker is the default. Build the sandbox with: npm run sandbox:build
SHELL_LAB_RUNTIME=docker
SHELL_LAB_IMAGE=shell-lab-sandbox:1
PORT=3001

# Development only, on a trusted single-user Linux machine:
# SHELL_LAB_RUNTIME=local
# Local mode executes as your OS user, with no filesystem or resource isolation.

# Optional overrides for a custom, already installed OpenSSH server.
# start.sh automatically prepares project-local tools on supported APT systems.
# SHELL_LAB_SSHD=/absolute/path/to/sshd
# SHELL_LAB_SFTP_SERVER=/absolute/path/to/sftp-server
# SHELL_LAB_SSH_LIB_DIR=/absolute/path/to/required/libraries

# Optional AI scene planner (Chat Completions-compatible HTTP API).
# Without these settings, local dynamic generation works without a model.
# Include /v1 if your service uses that prefix. Keys stay on the server.
# SHELL_LAB_AI_BASE_URL=https://your-provider.example/v1
# SHELL_LAB_AI_MODEL=your-model-name
# SHELL_LAB_AI_API_KEY=your-api-key
# For providers without JSON Schema support, use JSON object mode:
# SHELL_LAB_AI_JSON_MODE=object
